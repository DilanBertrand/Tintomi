# Copy this file to `.env` in the project root, then restart `npm run dev`.
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Production only: base URL for email confirmation redirects.
# Must also be added to Supabase Dashboard → Authentication → URL Configuration
# (Site URL + Redirect URLs), or Supabase ignores this and uses its own Site URL.
# VITE_SITE_URL=https://www.tintomi.com

# Optional
# VITE_FINNHUB_TOKEN=
